{
  "name": "parkease-backend",
  "version": "1.0.0",
  "description": "ParkEase API + static frontend server (Express + PostgreSQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "vendor": "node scripts/vendor.js",
    "db:check": "node scripts/check-db.js",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed.js",
    "setup": "npm run vendor && npm run db:init && npm run db:seed"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "1.9.4",
    "lucide": "0.454.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "license": "UNLICENSED",
  "private": true
}
